# Firebase web config: these identify your project and are safe to ship in the bundle.
# They are NOT secrets. Never put provider API keys (Sarvam, Google, Anthropic) here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Backend API (Cloud Run "api" service)
VITE_API_BASE_URL=http://localhost:8080
# Set to "true" to talk to the local Firebase emulators
VITE_USE_EMULATORS=false
