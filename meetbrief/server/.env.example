# Copy to server/.env for local development. In production these come from Cloud Run
# environment variables and Secret Manager. NEVER expose these to the web app.
ROLE=all                     # api | worker | all
PORT=8080
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
CORS_ORIGINS=http://localhost:5173

QUEUE_DRIVER=local           # local | cloud-tasks
CLOUD_TASKS_LOCATION=asia-south1
CLOUD_TASKS_QUEUE=meetbrief-jobs
WORKER_URL=                  # https://meetbrief-worker-xxxx.a.run.app
TASKS_SERVICE_ACCOUNT=       # meetbrief-tasks@PROJECT.iam.gserviceaccount.com

STT_PROVIDER=mock            # mock | sarvam | google
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
GOOGLE_STT_LOCATION=asia-south1
GOOGLE_STT_MODEL=chirp_3

LLM_PROVIDER=mock            # mock | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high

WINDOW_SECONDS=600
